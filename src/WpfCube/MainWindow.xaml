<Window x:Class="WpfCube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Cube" Height="500" Width="500" Background="#111418"
        MouseLeftButtonDown="OnMouseDown" MouseLeftButtonUp="OnMouseUp"
        MouseMove="OnMouseMove" MouseWheel="OnMouseWheel" KeyDown="OnKeyDown">
    <Grid>
        <Viewport3D x:Name="Viewport">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera" Position="0,0,-6" LookDirection="0,0,1" UpDirection="0,1,0" FieldOfView="50" />
            </Viewport3D.Camera>

            <!-- Lighting: a soft ambient fill so no face is black, plus a directional key light
                 that comes from over the viewer's shoulder to model the cube's form. -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#404040" />
                        <DirectionalLight Color="#D0D0D0" Direction="-0.5,-1,1" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- The cube. Its geometry is built in code (see CubeMesh); here we only give it the
                 rotation we drive from the mouse and the auto-spin timer. -->
            <ModelVisual3D x:Name="CubeVisual">
                <ModelVisual3D.Transform>
                    <RotateTransform3D>
                        <RotateTransform3D.Rotation>
                            <!-- A quaternion accumulates arbitrary drag rotation without gimbal issues. -->
                            <QuaternionRotation3D x:Name="Rotation" Quaternion="0,0,0,1" />
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                </ModelVisual3D.Transform>
            </ModelVisual3D>
        </Viewport3D>

        <TextBlock Foreground="#80FFFFFF" Margin="12" VerticalAlignment="Bottom" FontFamily="Consolas"
                   Text="drag — rotate    wheel — zoom    space — toggle auto-spin" />
    </Grid>
</Window>
